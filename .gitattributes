# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicit overrides for key file types
*.go   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.json text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.sh   text eol=lf

# Binary assets — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
